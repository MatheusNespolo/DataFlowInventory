#ifndef SECRETS_H
#define SECRETS_H

// ---------- Wi-Fi ----------
#define SECRET_WIFI_SSID          "SUA_REDE_WIFI"
#define SECRET_WIFI_PASS          "SUA_SENHA_WIFI"

// ---------- MQTT: broker LOCAL (USE_TLS false) ----------
#define SECRET_MQTT_SERVER_LOCAL  "192.168.0.10"   // IP do PC com Mosquitto (ipconfig)
#define SECRET_MQTT_USER_LOCAL    ""               // vazio = broker anônimo
#define SECRET_MQTT_PASS_LOCAL    ""

// ---------- MQTT: broker NUVEM (USE_TLS true) ----------
#define SECRET_MQTT_SERVER_CLOUD  "SEU_CLUSTER.s1.eu.hivemq.com"
#define SECRET_MQTT_USER_CLOUD    "SEU_USUARIO_HIVEMQ"
#define SECRET_MQTT_PASS_CLOUD    "SUA_SENHA_HIVEMQ"

#endif // SECRETS_H
