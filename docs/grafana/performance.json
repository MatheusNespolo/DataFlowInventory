{
  "uid": "dfi-performance",
  "title": "Data Flow Inventory — Performance",
  "description": "Latências (p50/p95/p99), throughput e consumo do servidor.",
  "tags": [
    "dataflow-inventory",
    "observabilidade"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {},
