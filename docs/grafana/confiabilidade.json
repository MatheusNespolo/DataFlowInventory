      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"dfi-server\"}",
          "legendFormat": "Servidor Node.js",
          "datasource": {
            "type": "prometheus",
            "uid": "dfi-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "dfi_mqtt_connected",
          "legendFormat": "Broker MQTT",
          "datasource": {
            "type": "prometheus",
            "uid": "dfi-prometheus"
          }
        },
        {
          "refId": "C",
          "expr": "dfi_gateway_online",
          "legendFormat": "Gateway ESP32",
          "datasource": {
            "type": "prometheus",
            "uid": "dfi-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "OFFLINE",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "ONLINE",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "custom": {
            "fillOpacity": 70,
            "lineWidth": 0
          }
        },
        "overrides": []
      },
      "options": {
        "mergeValues": true,
        "showValue": "never",
        "rowHeight": 0.9,
        "alignValue": "left",
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
