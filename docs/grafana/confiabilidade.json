{
  "uid": "dfi-confiabilidade",
  "title": "Data Flow Inventory — Confiabilidade",
  "description": "Uptime, reconexões, erros, quedas do gateway e comandos sem resposta.",
  "tags": [
    "dataflow-inventory",
    "observabilidade"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
