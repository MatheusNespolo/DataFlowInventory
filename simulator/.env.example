# ============================================================
# SIMULADOR — Variáveis de Ambiente (Exemplo)
# ============================================================
# COMO USAR:
#   1. Copie este arquivo para ".env" na mesma pasta:
#        copy .env.example .env   (Windows)
#        cp   .env.example .env   (Linux/Mac)
#   2. Preencha os valores conforme necessário.
#   3. NUNCA versione .env — o .gitignore já o ignora.
# ============================================================

# Porta do servidor web (padrão: 3000)
PORT=3000

# ============================================================
# INTEGRAÇÃO MQTT (OPCIONAL — Modo Beckhoff CX9240)
# ============================================================
# Ativa com: MQTT_PUBLISH=true npm start  (ou npm run start:mqtt)
#
# Quando ativo, o simulador publica o estoque em:
#   tópico : dataflow/estoque
#   payload: {"type":"estoque","pecaA":N,"pecaB":N,"pecaC":N}
#   QoS    : 1 | retained: true
#
# Ver: docs/INTEGRATION_GUIDE.md para contrato completo

MQTT_PUBLISH=false

# URL do broker MQTT (ex.: mqtt://127.0.0.1 para local, mqtts://cluster.s1.eu.hivemq.com para nuvem)
MQTT_BROKER_URL=mqtt://127.0.0.1

# Porta do broker (1883 = local sem TLS, 8883 = nuvem com TLS)
MQTT_PORT=1883

# Credenciais MQTT (deixar vazias para broker anônimo local)
MQTT_USER=
MQTT_PASS=

# Tópico onde publicar estoque (padrão: dataflow/estoque)
MQTT_TOPIC_ESTOQUE=dataflow/estoque

# ============================================================
# TIMINGS DA SIMULAÇÃO (ms)
# ============================================================
# Estes valores definem a duração das etapas simuladas da FSM.
# Não afetam o modo online (Socket.IO) — apenas a velocidade da simulação.

DELAY_VERIFICACAO=300
DELAY_ACIONAMENTO=200
DELAY_ENTREGA=1500

# Intervalo mínimo (ms) entre comandos de um mesmo cliente (anti-flood)
COMANDO_INTERVALO_MS=500
