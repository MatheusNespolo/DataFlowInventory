# ============================================================
# DATA FLOW INVENTORY — Configurações do Servidor (EXEMPLO)
# ============================================================
# Copie este arquivo para .env e preencha com seus dados:
#   copy .env.example .env    (Windows)
#   cp .env.example .env      (Linux/Mac)
#
# NUNCA versione o .env com dados reais de autenticação.
# (o .gitignore já ignora server/.env)
# ============================================================

# Porta do servidor HTTP/WebSocket
PORT=3000

# ============================================================
# SEGURANÇA — CORS / WebSocket
# ============================================================
# Origens permitidas para o Socket.IO (dashboard).
# Lista separada por vírgulas. Use "*" apenas em bancada isolada.
# Ex.: ALLOWED_ORIGIN=http://localhost:3000,http://192.168.0.10:3000
ALLOWED_ORIGIN=http://localhost:3000

# Intervalo mínimo (ms) entre comandos de um mesmo cliente WebSocket.
# Protege o broker MQTT e o Arduino contra floods vindos do dashboard.
COMANDO_INTERVALO_MS=500

# ============================================================
# CONFIGURAÇÃO DO BROKER MQTT
# ============================================================
# Escolha UMA das opções abaixo (descomente a que usar) e
# comente as demais.
# ============================================================

# ----------------------------------------------------------
# OPÇÃO 1: Mosquitto Local (desenvolvimento / demonstração)
# ----------------------------------------------------------
# Broker rodando na mesma máquina. Sem autenticação, sem TLS.
# Instale: https://mosquitto.org/download/
# Inicie:  mosquitto -d
# ----------------------------------------------------------
MQTT_BROKER_URL=mqtt://localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# ----------------------------------------------------------
# OPÇÃO 2: Mosquitto Local com Autenticação (recomendado)
# ----------------------------------------------------------
# Crie um arquivo mosquitto.conf com:
#   listener 1883
#   allow_anonymous false
#   password_file /caminho/para/mosquitto.passwd
# Gere senhas: mosquitto_passwd -c -b mosquitto.passwd user senha
# ----------------------------------------------------------
# MQTT_BROKER_URL=mqtt://localhost
# MQTT_PORT=1883
# MQTT_USERNAME=<SEU_USUARIO>
# MQTT_PASSWORD=<SUA_SENHA>

# ----------------------------------------------------------
# OPÇÃO 3: HiveMQ Cloud (nuvem, TLS)
# ----------------------------------------------------------
# Crie conta gratuita em: https://cloud.hivemq.com
# Preencha o endpoint, usuário e senha do cluster.
# ----------------------------------------------------------
# ATENÇÃO: use mqtts:// (com "s") para conexão TLS na porta 8883.
# MQTT_BROKER_URL=mqtts://<SEU_CLUSTER>.s1.eu.hivemq.com
# MQTT_PORT=8883
# MQTT_USERNAME=<SEU_USERNAME_HIVEMQ>
# MQTT_PASSWORD=<SUA_SENHA_HIVEMQ>

# ----------------------------------------------------------
# OPÇÃO 4: AWS IoT Core (nuvem, TLS + certificados)
# ----------------------------------------------------------
# Requer conta AWS e certificados X.509.
# Preencha o endpoint do IoT Core.
# ----------------------------------------------------------
# MQTT_BROKER_URL=mqtts://<ENDPOINT>.iot.<REGIAO>.amazonaws.com
# MQTT_PORT=8883
# MQTT_USERNAME=
# MQTT_PASSWORD=

# ============================================================
# CLIENT ID (identifica este servidor no broker)
# ============================================================
# IMPORTANTE: Cada instância deve ter um ID único.
# Se rodar múltiplos servidores, altere este valor.
MQTT_CLIENT_ID=dataflow-node-server

# ============================================================
# TÓPICOS MQTT
# ============================================================
# Nomes dos tópicos usados para publicar/assinar mensagens.
# O Arduino/ESP32 devem usar os MESMOS nomes.
# Altere apenas se mudar a estrutura de tópicos.
# ============================================================
MQTT_TOPIC_STATUS=dataflow/status
MQTT_TOPIC_ESTOQUE=dataflow/estoque
MQTT_TOPIC_EVENTOS=dataflow/eventos
MQTT_TOPIC_SENSORES=dataflow/sensores
MQTT_TOPIC_ESTEIRAS=dataflow/esteiras
MQTT_TOPIC_CMD_SUB=dataflow/comandos/sub
MQTT_TOPIC_CMD_PUB=dataflow/comandos/pub