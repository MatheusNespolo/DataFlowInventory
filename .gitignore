# Node.js
# Obs.: os package-lock.json SÃO versionados (builds reprodutíveis).
node_modules/
npm-debug.log*

# Variáveis de ambiente (senhas!)
.env
server/.env

# Segredos de firmware (Wi-Fi / MQTT) — cada bancada cria o seu a partir do .example
secrets.h
*_secrets.h
arduino_secrets.h

# Arduino / PlatformIO
*.ino.elf
*.ino.hex
.build/
.cache/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
Desktop.ini

# IDEs
.idea/
.vscode/

# Logs
*.log
logs/