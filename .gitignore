# ============================================================
# DATA FLOW INVENTORY — .gitignore
# ============================================================

# Node.js
# Obs.: os package-lock.json SÃO versionados (builds reprodutíveis).
node_modules/
**/node_modules/
npm-debug.log*

# Variáveis de ambiente (senhas!)
.env
*.env
*.env.local
server/.env
simulator/.env

# Segredos de firmware (Wi-Fi / MQTT) — cada bancada cria o seu a partir do .example
secrets.h
*_secrets.h
arduino_secrets.h

# Arduino / PlatformIO
*.ino.elf
*.ino.hex
.build/
.cache/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
Desktop.ini

# IDEs
.idea/
.vscode/

# Logs
*.log
logs/
esp32/test_mqtt_cloud/secrets.h.example

# Playwright (test/frontend_smoke)
test/frontend_smoke/test-results/
test/frontend_smoke/playwright-report/
test/frontend_smoke/capturas/

# Binário dos testes da lógica do firmware (test/firmware_uno)
test/firmware_uno/testes
